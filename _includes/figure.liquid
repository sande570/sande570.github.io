{% assign img_path = include.path | remove: '.jpg' | remove: '.JPG' | remove: '.jpeg' | remove: '.JPEG' | remove: '.png' | remove: '.PNG' | remove: '.tiff' | remove: '.TIFF' | remove: '.gif' | remove: '.GIF' %}
{% assign parts = include.path | split: '.' %}
{% assign ext = parts.last %}

<figure
  {% if include.slot %}
    slot="{{ include.slot }}"
  {% endif %}
  {% if include['figure-class'] %}
    class="{{ include['figure-class'] }}"
  {% endif %}
>
  {% if include['aspect-ratio'] %}<div style="aspect-ratio: {{ include['aspect-ratio'] }}; overflow: hidden;">{% endif %}
  <picture>
    <!-- Auto scaling with responsive images -->
    <!--
      See https://www.debugbear.com/blog/responsive-images#w-descriptors-and-the-sizes-attribute and
      https://developer.mozilla.org/en-US/docs/Learn/HTML/Multimedia_and_embedding/Responsive_images for info on defining 'sizes' for responsive images
    -->
    {% unless include.avoid_scaling %}
      {% if ext == 'gif' or ext == 'jpeg' or ext == 'jpg' or ext == 'png' or ext == 'tiff' %}
        <source
          class="responsive-img-srcset"
          srcset="{% for i in site.imagemagick.widths %}{{ img_path | relative_url }}-{{ i }}.webp {{ i }}w,{% endfor %}"
          type="image/webp"
          {% if include.sizes %}
            sizes="{{ include.sizes }}"
          {% else %}
            sizes="95vw"
          {% endif %}
        >
      {% endif %}
    {% endunless %}
    <img
      src="{% if include.url %}{{ include.url }}{% elsif include.cache_bust %}{{ include.path | relative_url | bust_file_cache }}{% else %}{{ include.path | relative_url }}{% endif %}"
      {% if include.class %}
        class="{{ include.class }}"
      {% endif %}
      {% if include.width %}
        width="{{ include.width }}"
      {% else %}
        width="100%"
      {% endif %}
      {% if include.height %}
        height="{{ include.height }}"
      {% else %}
        height="auto"
      {% endif %}
      {% if include['min-width'] or include['min-height'] or include['max-width'] or include['max-height'] or include['object-fit'] or include['aspect-ratio'] or include['object-position'] %}
        style="
          {% if include['min-width'] %}
            min-width: {{ include['min-width'] }};
          {% endif %}
          {% if include['min-height'] %}
            min-height: {{ include['min-height'] }};
          {% endif %}
          {% if include['max-width'] %}
            max-width: {{ include['max-width'] }};
          {% endif %}
          {% if include['max-height'] %}
            max-height: {{ include['max-height'] }};
          {% endif %}
          {% if include['object-fit'] %}
            object-fit: {{ include['object-fit'] }};
          {% elsif include['aspect-ratio'] %}
            object-fit: cover;
          {% endif %}
          {% if include['object-position'] %}
            object-position: {{ include['object-position'] }};
          {% endif %}
          {% if include['aspect-ratio'] %}
            width: 100%; height: 100%;
          {% endif %}
        "
      {% endif %}
      {% if include.alt %}
        alt="{{ include.alt }}"
      {% endif %}
      {% if include.title %}
        title="{{ include.title }}"
      {% endif %}
      {% if include.zoomable %}
        data-zoomable
      {% endif %}
      {% if include.loading %}
        loading="{{ include.loading }}"
      {% elsif site.lazy_loading_images %}
        loading="lazy"
      {% endif %}
      onerror="this.onerror=null; $('.responsive-img-srcset').remove();"
    >
  </picture>
  {% if include['aspect-ratio'] %}</div>{% endif %}

  {% if include.caption %}
    <figcaption class="caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
