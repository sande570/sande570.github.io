<div class="col mb-4">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable" style="overflow: hidden;">
      <div class="row no-gutters h-100">
        {% if project.img %}
          {% assign img_path = project.img | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
          <div class="col-md-6">
            <picture>
              <source
                srcset="{{ img_path | relative_url }}-480.webp 480w, {{ img_path | relative_url }}-800.webp 800w"
                type="image/webp"
                sizes="(max-width: 768px) 100vw, 50vw"
              >
              <img src="{{ project.img | relative_url }}" alt="project thumbnail" class="img-fluid" style="object-fit: cover; width: 100%; height: 100%; min-height: 300px;">
            </picture>
          </div>
        {% endif %}
        <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title">{{ project.title }}</h3>
            <div class="row ml-1 mr-1 p-0">
              {% if project.github %}
                <div class="github-icon">
                  <div class="icon" data-toggle="tooltip" title="Code Repository">
                    <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
                  </div>
                  {% if project.github_stars %}
                    <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                      <i class="fa-solid fa-star"></i>
                      <span id="{{ project.github_stars }}-stars"></span>
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
